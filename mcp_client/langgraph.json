{
  "graphs": {
    "askdata_getinsights": "app/getinsights/askdata_getinsights.py:askdata_getinsights",
    "agent_supervisor": "app/crossdomains/agent_supervisor.py:agent_supervisor",
    "agent_supervisor_swarm": "app/crossdomains/agent_supervisor_swarm.py:run_swarm",
    "agent_swarm": "app/crossdomains/agent_swarm.py:run_graph"
  },
  "dependencies": [
    "env: .env"
  ],
  "mounts": [
    {
      "source": "~/.oci/config",
      "target": "/home/app/.oci/config"
    },
    {
      "source": "~/.oci/oci_api_key.pem",
      "target": "/home/app/.oci/oci_api_key.pem"
    }
  ]
}
